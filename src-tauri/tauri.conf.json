{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parrot",
  "identifier": "in.basic.parrot",
  "build": {
    "beforeDevCommand": "npm run before:dev",
    "beforeBuildCommand": "npm run before:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Parrot",
        "width": 920,
        "height": 680,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "recording",
        "url": "recording.html",
        "title": "Parrot Recording",
        "width": 148,
        "height": 36,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "focusable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "../native-core/shared/languages.json",
      "../native-core/shared/models.json",
      "../native-core/shared/prompts/",
      "../native-core/shared/sounds.json",
      "../native-core/shared/sounds/"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1Mjc4MjlCODJGMzIzOTcKUldTWEkvT0NtNEluZFlVdDFQUmRLVU9RdUV1U0FZZm8ycUtjbTFQTytZYVpmOGJBWm51MGVIZTAK",
      "endpoints": [
        "https://github.com/basic-intelligence/parrot/releases/latest/download/latest.json"
      ]
    }
  },
  "version": "0.2.0"
}
